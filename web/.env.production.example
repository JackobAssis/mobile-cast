# Copie para .env.production antes de `npm run build` para deploy com TURN
# Render/Fly: build roda dentro do Docker, então passe via --build-arg ou defina no dashboard e rebuild
VITE_WS_URL=wss://mobile-cast-xxxx.onrender.com/ws
# TURN gratuito para testes fora da LAN (NAT restritivo)
VITE_TURN_URL=turn:openrelay.metered.ca:80
VITE_TURN_USER=openrelayproject
VITE_TURN_CRED=openrelayproject
